[0m15:02:39.922585 [debug] [Thread-1  ]: On model.seven_shifts_project.fct_vendor_signals: /* {"app": "dbt", "dbt_version": "1.10.22", "profile_name": "seven_shifts_project", "target_name": "dev", "node_id": "model.seven_shifts_project.fct_vendor_signals"} */

    
    create view main."fct_vendor_signals" as
    -- models/marts/fct_vendor_signals.sql

WITH base_companies AS (
    SELECT * FROM main."stg_companies"
),

base_locations AS (
    SELECT * FROM main."stg_locations"
),

base_crm AS (
    SELECT * FROM main."stg_crm_accounts"
),

aggregated AS (
    SELECT 
        c.account_id AS vendor_id,
        c.company_name AS vendor_name,
        c.website AS vendor_website,
        c.pos_vendor AS vendor_pos,
        crm.account_status,
        crm.last_contact_date,
        
        -- Geographic aggregation for NYC
        SUM(CASE 
            WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN 1 
            ELSE 0 
        END) AS total_nyc_locations,
        
        ROUND(AVG(CASE 
            WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN l.review_rating 
            ELSE NULL 
        END), 1) AS avg_nyc_rating,
        
        -- Aggregate cuisine types
        GROUP_CONCAT(DISTINCT l.cuisine_type) AS cuisines

    FROM base_companies c
    LEFT JOIN base_locations l ON c.account_id = l.account_id
    LEFT JOIN base_crm crm ON c.account_id = crm.account_id
    GROUP BY 1, 2, 3, 4, 5, 6
)

SELECT * FROM aggregated;
