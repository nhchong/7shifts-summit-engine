[0m18:05:17.396024 [debug] [Thread-1  ]: On model.seven_shifts_project.fct_vendor_signals: /* {"app": "dbt", "dbt_version": "1.10.22", "profile_name": "seven_shifts_project", "target_name": "dev", "node_id": "model.seven_shifts_project.fct_vendor_signals"} */

    
    create view main."fct_vendor_signals" as
    WITH crm AS (
    SELECT 
        company_id,
        company_name,
        LOWER(REPLACE(REPLACE(domain, 'www.', ''), 'https://', '')) AS clean_domain,
        plan_name AS crm_plan,
        locations_in_7shifts AS crm_location_count
    FROM main."stg_crm_accounts"
),

vendor_signals AS (
    SELECT 
        account_id AS vendor_id,
        company_name AS vendor_name,
        website AS vendor_website,
        LOWER(REPLACE(REPLACE(website, 'www.', ''), 'https://', '')) AS clean_domain,
        num_locations AS global_location_count,
        pos_vendor AS vendor_pos,
        SUM(CASE WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN 1 ELSE 0 END) AS total_nyc_locations,
        ROUND(AVG(CASE WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN l.review_rating ELSE NULL END), 1) AS avg_nyc_rating,
        GROUP_CONCAT(DISTINCT LOWER(l.cuisine_type)) AS cuisines
    FROM main."stg_companies" c
    LEFT JOIN main."stg_locations" l ON c.account_id = l.account_id
    GROUP BY 1, 2, 3, 4, 5
),

final_union AS (
    -- CRM side of the union: Explicitly nullify vendor-specific columns
    SELECT 
        clean_domain,
        company_id,
        company_name AS crm_name,
        crm_plan,
        crm_location_count,
        CAST(NULL AS TEXT) AS vendor_id,
        CAST(NULL AS TEXT) AS vendor_name,
        CAST(NULL AS TEXT) AS vendor_website,
        0 AS global_location_count,
        0 AS total_nyc_locations,
        0 AS avg_nyc_rating,
        CAST(NULL AS TEXT) AS vendor_pos,
        CAST(NULL AS TEXT) AS cuisines
    FROM crm

    UNION ALL

    -- Vendor side of the union: Explicitly nullify CRM-specific columns
    SELECT 
        clean_domain,
        CAST(NULL AS TEXT) AS company_id,
        CAST(NULL AS TEXT) AS crm_name,
        CAST(NULL AS TEXT) AS crm_plan,
        0 AS crm_location_count,
        vendor_id,
        vendor_name,
        vendor_website,
        global_location_count,
        total_nyc_locations,
        avg_nyc_rating,
        vendor_pos,
        cuisines
    FROM vendor_signals
)

SELECT * FROM final_union;
