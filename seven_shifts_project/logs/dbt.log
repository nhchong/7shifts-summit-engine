[0m17:55:13.582465 [debug] [Thread-1  ]: On model.seven_shifts_project.fct_vendor_signals: /* {"app": "dbt", "dbt_version": "1.10.22", "profile_name": "seven_shifts_project", "target_name": "dev", "node_id": "model.seven_shifts_project.fct_vendor_signals"} */

    
    create view main."fct_vendor_signals" as
    WITH crm AS (
    SELECT 
        company_id,
        company_name,
        LOWER(REPLACE(REPLACE(domain, 'www.', ''), 'https://', '')) AS clean_domain,
        plan_name AS crm_plan,
        locations_in_7shifts AS crm_location_count
    FROM main."stg_crm_accounts"
),

vendor_signals AS (
    SELECT 
        c.account_id AS vendor_id,
        c.company_name AS vendor_name,
        LOWER(REPLACE(REPLACE(c.website, 'www.', ''), 'https://', '')) AS clean_domain,
        c.num_locations AS global_location_count,
        c.pos_vendor AS vendor_pos,
        SUM(CASE WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN 1 ELSE 0 END) AS total_nyc_locations,
        ROUND(AVG(CASE WHEN l.city IN ('New York', 'Brooklyn', 'Queens', 'Bronx', 'Staten Island') THEN l.review_rating ELSE NULL END), 1) AS avg_nyc_rating,
        GROUP_CONCAT(DISTINCT LOWER(l.cuisine_type)) AS cuisines
    FROM main."stg_companies" c
    LEFT JOIN main."stg_locations" l ON c.account_id = l.account_id
    GROUP BY 1, 2, 3, 4, 5
),

master_join AS (
    -- Execute the Outer Merge previously handled by Pandas
    SELECT 
        COALESCE(c.clean_domain, v.clean_domain) AS primary_domain,
        c.company_id,
        c.company_name AS crm_name,
        c.crm_plan,
        c.crm_location_count,
        v.vendor_id,
        v.vendor_name,
        v.global_location_count,
        v.total_nyc_locations,
        v.avg_nyc_rating,
        v.vendor_pos,
        v.cuisines,
        -- Programmatic calculation of physical whitespace for upselling
        (COALESCE(v.global_location_count, 0) - COALESCE(c.crm_location_count, 0)) AS location_whitespace
    FROM crm c
    FULL OUTER JOIN vendor_signals v 
        ON c.clean_domain = v.clean_domain
),

filtered_and_segmented AS (
    SELECT 
        *,
        CASE 
            -- Bucket 1: Credible Partners
            WHEN company_id IS NOT NULL 
                 AND total_nyc_locations >= 3 
                 AND avg_nyc_rating >= 4.0 
            THEN 'CREDIBLE_PARTNER'
            
            -- Bucket 2: Expansion Opportunity (Math-driven Upsell Logic)
            WHEN company_id IS NOT NULL 
                 AND (location_whitespace >= 2 OR crm_plan IN ('Basic', 'Free', 'Starter'))
            THEN 'EXPANSION_OPPORTUNITY'
            
            -- Bucket 3: Net-New Market Target
            WHEN company_id IS NULL 
                 AND total_nyc_locations >= 1 
            THEN 'NET_NEW_TARGET'
            
            ELSE 'UNCLASSIFIED'
        END AS gtm_segment
    FROM master_join
    WHERE 
        -- Firmographic Boundary
        (global_location_count <= 50 OR global_location_count IS NULL)
        
        -- Keyword Boundary
        AND (cuisines NOT LIKE '%pharmacy%' 
             AND cuisines NOT LIKE '%cvs%' 
             AND cuisines NOT LIKE '%apparel%'
             AND cuisines NOT LIKE '%convenience%'
             AND cuisines NOT LIKE '%grocery%'
             AND cuisines NOT LIKE '%supermarket%'
             AND cuisines NOT LIKE '%department store%')
)

SELECT * FROM filtered_and_segmented
WHERE gtm_segment != 'UNCLASSIFIED';
